# ==============================================================================
# CodeTogether Backend Server Environment Variables
# ==============================================================================

# Server Network & Mode
PORT=4000
NODE_ENV=development

# Database (MongoDB Atlas recommended for production)
MONGODB_URI=mongodb://127.0.0.1:27017/codetogether
# Production Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/codetogether?retryWrites=true&w=majority

# Client Application URL for CORS & Invite Links
CLIENT_URL=http://localhost:5173
# Production Example (Vercel):
# CLIENT_URL=https://<your-app-name>.vercel.app

# JWT Secrets (Generate high-entropy random strings in production, min 32 characters)
JWT_ACCESS_SECRET=change-me-long-random-access-secret-32-chars-min
JWT_REFRESH_SECRET=change-me-long-random-refresh-secret-32-chars-min

# Sandboxed Code Execution Engine (local child process runner)
EXECUTOR=local
RUN_TIMEOUT_MS=5000
RUN_MEMORY_MB=256
RUN_OUTPUT_LIMIT_KB=64
RUN_CONCURRENCY=2

# Judge0 (optional fallback for cloud execution, leave blank to use built-in local sandbox)
JUDGE0_URL=
JUDGE0_KEY=

# AI Tutor (Google Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
